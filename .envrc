# Load the Java version pinned in .tool-versions without requiring shell rc edits.
watch_file .tool-versions

find_asdf() {
	if command -v asdf >/dev/null 2>&1; then
		command -v asdf
	elif [ -x /opt/homebrew/bin/asdf ]; then
		printf '%s\n' /opt/homebrew/bin/asdf
	elif [ -x /usr/local/bin/asdf ]; then
		printf '%s\n' /usr/local/bin/asdf
	else
		return 1
	fi
}

if ! ASDF_BIN="$(find_asdf)"; then
	log_error "asdf is required for this repo. Install it, then run: asdf plugin add java https://github.com/halcyon/asdf-java.git && asdf install"
	exit 1
fi

if ! JAVA_HOME="$($ASDF_BIN where java 2>/dev/null)"; then
	log_error "Java from .tool-versions is not installed. Run: asdf plugin add java https://github.com/halcyon/asdf-java.git && asdf install"
	exit 1
fi

export JAVA_HOME
PATH_add "$JAVA_HOME/bin"
